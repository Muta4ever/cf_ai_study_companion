{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-study-companion",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",

  "ai": {
    "binding": "AI"
  },

  "durable_objects": {
    "bindings": [
      {
        "class_name": "UserMemory",
        "name": "USER_MEMORY"
      }
    ]
  },

  "assets": {
    "directory": "./public"
  },

  "observability": {
    "enabled": true
  },

  "migrations": [
    {
      "new_sqlite_classes": [
        "UserMemory"
      ],
      "tag": "v1"
    }
  ]
}